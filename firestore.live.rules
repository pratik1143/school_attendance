rules_version = '2';

// Rules live on school-project-717c3. Everything is role-based: a signed-in account with no admin/staff
// claim can read and write nothing. The T800 backend and the admin API use the Admin SDK (not subject to rules).
// (firestore.rules in this repo is the larger, not-yet-deployed multi-school design.)
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrators: custom claim role in [super_admin, admin, school_admin], roles[] containing one, or admin: true.
    function adminClaim() {
      return request.auth != null && (
        (('role' in request.auth.token) && request.auth.token.role in ['super_admin', 'admin', 'school_admin']) ||
        (('roles' in request.auth.token) && request.auth.token.roles.hasAny(['super_admin', 'admin', 'school_admin'])) ||
        (('admin' in request.auth.token) && request.auth.token.admin == true)
      );
    }

    // Staff who may read school records: administrators plus principals and operators.
    function staffClaim() {
      return adminClaim() || (request.auth != null && (
        (('role' in request.auth.token) && request.auth.token.role in ['principal', 'operator']) ||
        (('roles' in request.auth.token) && request.auth.token.roles.hasAny(['principal', 'operator']))
      ));
    }

    // Students are written only through the admin API (Admin SDK); the web app just reads them.
    match /students/{studentId} {
      allow read: if staffClaim();
      allow write: if false;
    }

    // Teacher records: administrators only.
    match /teachers/{teacherId} {
      allow read: if adminClaim();
      allow create, update: if adminClaim()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
      allow delete: if adminClaim();
    }

    // Manual day marks (present / late / absent / leave) for students and teachers: administrators only.
    match /attendance_marks/{markId} {
      allow read: if adminClaim();
      allow create, update: if adminClaim()
        && request.resource.data.status in ['present', 'late', 'absent', 'leave']
        && request.resource.data.kind in ['student', 'teacher'];
      allow delete: if adminClaim();
    }

    // Device information; records are updated by the backend.
    match /devices/{deviceId} {
      allow read: if staffClaim();
      allow write: if false;
    }

    // Device users seen by the T800 (used by Device Enrollment).
    match /device_users/{id} {
      allow read: if adminClaim();
      allow write: if false;
    }

    // Attendance is created by the backend/T800 server; the web app only reads it.
    match /attendance/{attendanceId} {
      allow read: if staffClaim();
      allow write: if false;
    }

    // Raw T800 packets and synchronization logs: backend-only data, readable by administrators.
    match /raw_device_logs/{logId} {
      allow read: if adminClaim();
      allow write: if false;
    }
    match /sync_logs/{logId} {
      allow read: if adminClaim();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
