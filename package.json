{
  "name": "school-attendance-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node backend/node_modules/typescript/bin/tsc --project backend/tsconfig.json && node functions/node_modules/typescript/bin/tsc --project functions/tsconfig.json",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test backend/tests/*.test.ts",
    "typecheck": "node backend/node_modules/typescript/bin/tsc --project backend/tsconfig.json --noEmit",
    "backend:dev": "node --env-file-if-exists=backend/.env --experimental-strip-types --watch backend/src/server.ts",
    "backend:start": "node --env-file-if-exists=backend/.env --experimental-strip-types backend/src/server.ts",
    "backend:build": "node backend/node_modules/typescript/bin/tsc --project backend/tsconfig.json",
    "backend:test": "node --experimental-strip-types --test backend/tests/*.test.ts",
    "backend:test-client": "node --env-file-if-exists=backend/.env --experimental-strip-types backend/scripts/test-tcp-client.ts",
    "create-user": "node --experimental-strip-types backend/scripts/create-user.ts",
    "assign-tenant": "node --env-file-if-exists=backend/.env --experimental-strip-types backend/scripts/assign-tenant.ts",
    "set-admin": "node --env-file-if-exists=backend/.env --experimental-strip-types backend/scripts/set-admin-claim.ts",
    "webhook:test-server": "node --experimental-strip-types backend/scripts/test-webhook-server.ts"
  },
  "dependencies": { "firebase": "^12.19.0", "lucide-react": "^0.468.0", "react": "^19.3.0", "react-dom": "^19.3.0" },
  "devDependencies": { "@vitejs/plugin-react": "^6.0.0", "vite": "^8.3.1" }
}
