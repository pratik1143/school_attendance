# Node Environment
NODE_ENV=production

# Server Ports and Hosts
PORT=8080
HEALTH_PORT=8080
HEALTH_HOST=0.0.0.0
T800_TCP_PORT=8001
TCP_PORT=8001
API_PORT=8081
API_HOST=0.0.0.0
API_BASE_URL=

# Public API Settings
API_RATE_LIMIT=60
API_KEY_PEPPER=
CORS_ORIGINS=
DEFAULT_TENANT_ID=
DEFAULT_CLIENT_ID=

# Webhook Settings
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_PAYLOAD_BYTES=65536
WEBHOOK_MAX_RESPONSE_BYTES=8192
WEBHOOK_WORKER_CONCURRENCY=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAYS_MS=60000,300000,900000,3600000
WEBHOOK_FAILURE_THRESHOLD=10
WEBHOOK_MAX_PER_MINUTE=60
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_LOCALHOST=false

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=school-project-717c3
FIRESTORE_WRITES_ENABLED=true

# T800 Device Identity & Limits
T800_DEVICE_ID=T800_01
T800_CLOUD_ID=02010A964EDF2575
T800_DEVICE_NAME=Main Gate T800
T800_MODEL=T800
T800_CONNECTION_TYPE=wifi
MAX_CONNECTIONS=16
MAX_PACKET_BYTES=65536
MAX_PACKETS_PER_SECOND=30
MAX_BYTES_PER_SECOND=262144
LOG_RAW_PACKETS=false
DIAGNOSTIC_MODE=false
